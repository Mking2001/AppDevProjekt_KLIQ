<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Basis-Theme der Anwendung.

        Ersetzt das bisher direkt referenzierte Plattform-Theme, damit
        Fensterhintergrund und Systemleisten kontrolliert gesetzt werden können.
        Status- und Navigationsleiste sind transparent, weil MainActivity
        enableEdgeToEdge() aufruft und Compose die Insets selbst behandelt.
    -->
    <style name="Theme.Kliq" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/kliq_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
